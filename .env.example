# ==========================================
# AFFECIO TRUST — Environment Configuration
# ==========================================

# Server Port (Default: 3000)
PORT=3000
NODE_ENV=production

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/affecio-trust?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/affecio-trust

# JWT Secret for Session Tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Institutional Email Domain (Strictly Enforced)
# Only students with an official university email from this domain can sign up/in
ALLOWED_EMAIL_DOMAIN=kiit.ac.in

# Frontend URL for CORS configuration
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Redirect URI: https://your-domain.vercel.app/api/auth/google/callback or http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudinary Storage URL (Optional for direct photo storage)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
